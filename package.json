{
  "name": "otw-db",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.5.2",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "pnpm -r build",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm test",
    "test:e2e": "pnpm build && playwright test && pnpm --filter @otwdesign/db-example-next test:e2e && pnpm --filter @otwdesign/db-example-cms build && pnpm --filter @otwdesign/db-example-cms test:e2e"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@otwdesign/db-core": "workspace:*",
    "@otwdesign/db-node": "workspace:*",
    "@playwright/test": "1.64.1",
    "@types/node": "^24.0.0",
    "eslint": "^10.0.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  }
}
