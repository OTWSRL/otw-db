{
  "name": "@otwdesign/db-core",
  "version": "1.2.0",
  "description": "A database manager's engine and HTTP API, as one Fetch handler: browse, query and inspect PostgreSQL, MySQL and SQLite from any app.",
  "license": "Apache-2.0",
  "author": "OTW SRL",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OTWSRL/otw-db.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/OTWSRL/otw-db/tree/main/packages/core#readme",
  "bugs": {
    "url": "https://github.com/OTWSRL/otw-db/issues"
  },
  "keywords": [
    "database",
    "postgresql",
    "mysql",
    "mariadb",
    "sqlite",
    "sql",
    "admin"
  ],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "exports": {
    ".": {
      "@otwdesign/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./format": {
      "@otwdesign/source": "./src/format.ts",
      "types": "./dist/format.d.ts",
      "default": "./dist/format.js"
    },
    "./routes": {
      "@otwdesign/source": "./src/routes.ts",
      "types": "./dist/routes.d.ts",
      "default": "./dist/routes.js"
    }
  },
  "files": [
    "dist",
    "src",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@otwdesign/db-ui": "workspace:*"
  },
  "peerDependencies": {
    "pg": "^8.11.0",
    "pg-cursor": "^2.10.0",
    "mysql2": "^3.11.0"
  },
  "peerDependenciesMeta": {
    "pg": {
      "optional": true
    },
    "pg-cursor": {
      "optional": true
    },
    "mysql2": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/pg": "^8.23.1",
    "@types/pg-cursor": "^2.7.2",
    "pg": "^8.23.1",
    "pg-cursor": "^2.22.1",
    "mysql2": "^3.24.6",
    "@electric-sql/pglite": "^0.5.13"
  }
}
