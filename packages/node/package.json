{
  "name": "@otwdesign/db-node",
  "version": "1.0.1",
  "description": "OTW DB for Node servers: node:http, Express, Connect, Fastify and Koa; Hono, Bun and Deno take db-core's Fetch handler as it is.",
  "license": "Apache-2.0",
  "author": "OTW SRL",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OTWSRL/otw-db.git",
    "directory": "packages/node"
  },
  "homepage": "https://github.com/OTWSRL/otw-db/tree/main/packages/node#readme",
  "bugs": {
    "url": "https://github.com/OTWSRL/otw-db/issues"
  },
  "keywords": [
    "database",
    "admin",
    "express",
    "fastify",
    "koa"
  ],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "exports": {
    ".": {
      "@otwdesign/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./cli": {
      "@otwdesign/source": "./src/cli.ts",
      "types": "./dist/cli.d.ts",
      "default": "./dist/cli.js"
    }
  },
  "files": [
    "dist",
    "src",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@otwdesign/db-core": "workspace:*"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "express": "^5.3.0",
    "fastify": "^5.12.8",
    "koa": "^3.3.0",
    "@types/koa": "^3.0.3",
    "koa-bodyparser": "^4.4.1",
    "@types/koa-bodyparser": "^4.3.13",
    "hono": "^4.13.16",
    "@hono/node-server": "^2.1.6"
  }
}
