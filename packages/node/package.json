{
  "name": "@otwdesign/db-node",
  "version": "0.0.0",
  "description": "OTW DB for Node servers: node:http, Express, Connect, Fastify and Koa; Hono, Bun and Deno take db-core's Fetch handler as it is.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "exports": {
    ".": {
      "@otwdesign/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./cli": {
      "@otwdesign/source": "./src/cli.ts",
      "types": "./dist/cli.d.ts",
      "default": "./dist/cli.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@otwdesign/db-core": "workspace:*"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "express": "^5.3.0",
    "fastify": "^5.12.8",
    "koa": "^3.3.0",
    "@types/koa": "^3.0.3",
    "koa-bodyparser": "^4.4.1",
    "@types/koa-bodyparser": "^4.3.13",
    "hono": "^4.13.16",
    "@hono/node-server": "^2.1.6"
  }
}
